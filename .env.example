# Mọi biến NEXT_PUBLIC_* đều CÔNG KHAI — Next inline chúng vào bundle lúc build.
# Đừng bao giờ đặt bí mật ở đây. Copy file này thành .env (đã gitignore) để chạy local.
# Không có giá trị mặc định nào trong code: thiếu biến nào thì tính năng tắt.

# ── Đường dẫn gốc của app ────────────────────────────────────────────────
# Local: để TRỐNG (chạy ở gốc "/"). GitHub Pages: "/web-game-duck-flap" — do
# deploy.yml tự đặt, KHÔNG có dấu "/" ở cuối.
NEXT_PUBLIC_BASE_PATH=

# ── Ducker ID SSO (OIDC Authorization Code + PKCE) — tính năng ship "tối" ──
# Game là public client (không backend) nên KHÔNG có client_secret.
# Chỉ giá trị chính xác "true" mới bật. deploy.yml KHÔNG truyền cờ này nên bản
# deploy trên GitHub Pages không bao giờ hiện nút đăng nhập.
NEXT_PUBLIC_FEATURE_DUCKER_SIGN_IN=true

# Gốc của Ducker ID (nơi có /oauth/authorize, /oauth/token, /oauth/userinfo).
NEXT_PUBLIC_DUCKER_ISSUER=http://localhost:3000
# client_id của game này, đăng ký trong admin console của Ducker ID.
NEXT_PUBLIC_DUCKER_CLIENT_ID=
# Scope xin khi đăng nhập — phải nằm trong allowed scopes của client.
NEXT_PUBLIC_DUCKER_SCOPE=openid profile email
# Trang hồ sơ trên Ducker ID mà menu tài khoản liên kết tới (tương đối với ISSUER).
NEXT_PUBLIC_DUCKER_PROFILE_PATH=/profile

# ── Đăng ký phía Ducker ID ───────────────────────────────────────────────
# Redirect URI phải khớp TUYỆT ĐỐI (origin + base path + "/"):
#   local : http://localhost:<cổng>/ — Ducker ID thường giữ cổng 3000, nên chạy game
#           bằng `pnpm dev --port 3400` rồi đăng ký http://localhost:3400/
#   prod  : https://levananhduc.github.io/web-game-duck-flap/
# Thêm origin của game (vd http://localhost:3400) vào CORS_ORIGINS của server Ducker ID,
# vì trình duyệt gọi thẳng /oauth/token và /oauth/userinfo.
